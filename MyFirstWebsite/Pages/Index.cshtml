                <h4>🤖 AI FAQ Chatbot</h4>
                <p class="craft-tags">Python · NLP · Scikit-Learn</p>
                <div class="craft-buttons">
                    <a href="https://github.com/nayrozsherif5-tech/CodeAlpha_ChatbotFAQ" target="_blank" class="btn">Code</a>
                    <a asp-page="/FaqChatbot" class="btn">Details</a>
                </div>
            </div>

            <!-- YOLO Object Detection -->
            <div class="craft-card craft-yolo">
                <img src="/image/ObjectDetection.png" alt="YOLO Object Detection">
                <h4>👁 YOLO Object Detection</h4>
                <p class="craft-tags">Python · OpenCV · YOLO</p>
                <div class="craft-buttons">
                    <a href="https://github.com/nayrozsherif5-tech/CodeAlpha_ObjectDetectionTracking" target="_blank" class="btn">Code</a>
                    <a asp-page="/YoloProject" class="btn">Details</a>
                </div>
            </div>
        </div>

        <p class="craft-note">
            These are just a few highlighted projects I’ve worked on.
            If you’d like to explore all of my projects, please check the full
            <a href="/Projects">Projects section</a>.
        </p>

           

    </section>

 

