<!-- =====================================================
     ACTIVITIES
===================================================== -->

<section class="activities-section">

    <div class="activities-heading">

        <span class="section-kicker">
            ACTIVITIES
        </span>

        <h2>Beyond the classroom</h2>

        <p>
            Activities and initiatives that have contributed to my
            communication, teamwork, and professional development.
        </p>

    </div>


    <div class="activities-grid">

        @foreach (var activity in Model.Activities)
        {
            <article class="activity-card">

                <div class="activity-icon">
                    🌟
                </div>

                <div class="activity-content">

                    <span class="activity-date">

                        @if (activity.EndDate.HasValue)
                        {
                            if (activity.StartDate.Year == activity.EndDate.Value.Year &&
                            activity.StartDate.Month == activity.EndDate.Value.Month)
                            {
                                @activity.StartDate.ToString("MMM yyyy")
                            }
                            else
                            {
                                @($"{activity.StartDate:MMM yyyy} — {activity.EndDate.Value:MMM yyyy}")
                            }
                        }
                        else
                        {
                            @activity.StartDate.ToString("MMM yyyy")
                        }

                    </span>

                    <h3>
                        @activity.Title
                    </h3>

                    <h4>
                        @activity.Organization
                    </h4>

                    <p>
                        @activity.Description
                    </p>

                @if (!string.IsNullOrWhiteSpace(activity.Link))
                    {
                        <a href="@activity.Link"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="activity-link">
                            View Activity →
                        </a>
                    }

                </div>

            </article>
        }

    </div>

</section>


