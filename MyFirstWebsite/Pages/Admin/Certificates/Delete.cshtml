@page
@model MyFirstWebsite.Pages.Admin.Certificates.DeleteModel

@{
    ViewData["Title"] = "Delete Certificate";
}

<div class="admin-form-page">

    <div class="admin-form-header">
        <h1>🗑 Delete Certificate</h1>
        <p>Review the certificate before deleting it.</p>
    </div>

    <div class="admin-form-card">

        <div class="delete-warning-box">
            <h3>Are you sure you want to delete this certificate?</h3>
            <p>This action cannot be undone.</p>
        </div>

        <div class="delete-certificate-preview">

            <h2>@Model.Certificate.Title</h2>

            <p class="admin-certificate-issuer">
                Issued by
                <strong>@Model.Certificate.Organization</strong>
                • @Model.Certificate.Date.Year
            </p>

            <p class="admin-certificate-description">
                @Model.Certificate.Description
            </p>

            @if (!string.IsNullOrWhiteSpace(Model.Certificate.ImagePath))
            {
                <a href="@Model.Certificate.ImagePath"
                   target="_blank"
                   class="current-file-btn">
                    👁 View Credential
                </a>
            }

        </div>

        <form method="post">

            <input type="hidden"
                   asp-for="Certificate.Id" />

            <div class="admin-form-actions">

                <button type="submit"
                        class="admin-delete-confirm-btn">
                    🗑 Delete Certificate
                </button>

                <a asp-page="Index"
                   class="admin-cancel-btn">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>