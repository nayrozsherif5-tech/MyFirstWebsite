@page
@model MyFirstWebsite.Pages.Admin.Messages.IndexModel

@{
    ViewData["Title"] = "Messages";
}


<div class="admin-messages-page">
    <a asp-page="/Admin/Index" class="admin-back-btn">
        ← Back to Dashboard
    </a>
    <div class="admin-page-header">
        <div>
            <h1>📩 Messages</h1>
            <p>Messages received from your Contact Me form.</p>
        </div>
    </div>

    @if (Model.Messages.Count == 0)
    {
        <div class="admin-empty-state">
            <h3>No messages yet</h3>
            <p>New messages will appear here.</p>
        </div>
    }
    else
    {
        <div class="admin-message-list">

            @foreach (var message in Model.Messages)
            {
                <div class="admin-message-card @(message.IsRead ? "message-read" : "message-unread")">

                    <div class="admin-message-top">

                        <div>
                            <h2>@message.Subject</h2>

                            <p class="admin-message-sender">
                                From <strong>@message.Name</strong>
                            </p>
                        </div>

                        <span class="admin-message-date">
                            @message.CreatedAt.ToString("dd MMM yyyy • HH:mm")
                        </span>

                    </div>

                    <div class="admin-message-email">
                        📧
                        <a href="mailto:@message.Email">
                            @message.Email
                        </a>
                    </div>

                    <div class="admin-message-body">
                        @message.Message
                    </div>
                    <div class="admin-message-actions">

                        <a href="mailto:@message.Email?subject=Re: @message.Subject"
                           class="admin-message-reply-btn">
                            ↩ Reply by Email
                        </a>

                        <form method="post"
                              asp-page-handler="ToggleRead"
                              asp-route-id="@message.Id">

                            <button type="submit"
                                    class="admin-message-read-btn">

                                @if (message.IsRead)
                                {
                                    <span>✉ Mark as Unread</span>
                                }
                                else
                                {
                                    <span>✓ Mark as Read</span>
                                }

                            </button>

                        </form>
                        <form method="post"
                              asp-page-handler="Delete"
                              asp-route-id="@message.Id"
                              class="delete-message-form">

                            <button type="button"
                                    class="admin-message-delete-btn open-delete-modal">
                                🗑 Delete
                            </button>

                        </form>

                    </div>

                </div>
            }

        </div>
    }

</div>


<!-- =====================================================
     DELETE CONFIRMATION MODAL
===================================================== -->

<div id="deleteModal" class="delete-modal">

    <div class="delete-modal-box">

        <div class="delete-modal-icon">
            🗑
        </div>

        <h2>Delete Message?</h2>

        <p>
            Are you sure you want to delete this message?
            This action cannot be undone.
        </p>

        <div class="delete-modal-actions">

            <button type="button"
                    id="cancelDelete"
                    class="delete-modal-cancel">
                Cancel
            </button>

            <button type="button"
                    id="confirmDelete"
                    class="delete-modal-confirm">
                Delete
            </button>

        </div>

    </div>

</div>


<!-- =====================================================
     DELETE MODAL SCRIPT
===================================================== -->
@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const modal = document.getElementById("deleteModal");
            const cancelButton = document.getElementById("cancelDelete");
            const confirmButton = document.getElementById("confirmDelete");
            const deleteButtons = document.querySelectorAll(".open-delete-modal");

            let selectedForm = null;


            deleteButtons.forEach(button => {

                button.addEventListener("click", function () {

                    selectedForm = this.closest(".delete-message-form");

                    modal.classList.add("show");

                });

            });


            cancelButton.addEventListener("click", function () {

                modal.classList.remove("show");
                selectedForm = null;

            });


            confirmButton.addEventListener("click", function () {

                if (selectedForm) {
                   selectedForm.requestSubmit();
                }

            });


            modal.addEventListener("click", function (event) {

                if (event.target === modal) {

                    modal.classList.remove("show");
                    selectedForm = null;

                }

            });

        });

    </script>

}