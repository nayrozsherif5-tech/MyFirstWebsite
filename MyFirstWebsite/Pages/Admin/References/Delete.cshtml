@page
@model MyFirstWebsite.Pages.Admin.References.DeleteModel

@{
    ViewData["Title"] = "Delete Reference";
}

<div class="admin-form-page">

    <!-- Back Button -->
    <a asp-page="Index" class="admin-back-btn">
        ← Back to References
    </a>


    <!-- Page Header -->
    <div class="admin-form-header">

        <h1>🗑 Delete Reference</h1>

        <p>
            Review the reference before deleting it.
        </p>

    </div>


    <!-- Delete Card -->
    <div class="admin-form-card delete-confirmation-card">


        <!-- Warning -->
        <div class="delete-warning-box">

            <div class="delete-warning-icon">
                ⚠️
            </div>

            <div>
                <h3>
                    Are you sure you want to delete this reference?
                </h3>

                <p>
                    This action cannot be undone.
                </p>
            </div>

        </div>


        <!-- Reference Information -->
        <div class="delete-item-preview">

            <div class="delete-item-icon">
                📄
            </div>

            <div class="delete-item-info">

                <strong>
                    @Model.Reference.Title
                </strong>

                <p>
                    @Model.Reference.Description
                </p>

            </div>

        </div>


        <!-- Delete Form -->
        <form method="post">

            <input type="hidden"
                   asp-for="Reference.Id" />


            <div class="admin-form-actions">

                <button type="submit"
                        class="admin-delete-btn">

                    🗑 Delete Reference

                </button>


                <a asp-page="Index"
                   class="admin-cancel-btn">

                    Cancel

                </a>

            </div>

        </form>

    </div>

</div>