@page
@model MyFirstWebsite.Pages.Admin.References.DeleteModel

@{
    ViewData["Title"] = "Delete Reference";
}

<div class="admin-form-page">

    <div class="admin-form-header">
        <h1>🗑 Delete Reference</h1>
        <p>Review the reference before deleting it.</p>
    </div>

    <div class="admin-form-card">

        <div class="delete-warning-box">
            <h3>Are you sure you want to delete this reference?</h3>
            <p>This action cannot be undone.</p>
        </div>

        <div class="current-file">

            <div>
                <span>📄</span>

                <div>
                    <strong>@Model.Reference.Title</strong>
                    <p>@Model.Reference.Description</p>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Reference.FilePath))
            {
                <a href="@Model.Reference.FilePath"
                   target="_blank"
                   class="current-file-btn">
                    👁 View File
                </a>
            }

        </div>

        <form method="post">

            <input type="hidden"
                   asp-for="Reference.Id" />

            <div class="admin-form-actions">

                <button type="submit"
                        class="admin-delete-btn">
                    🗑 Delete Reference
                </button>

                <a asp-page="Index"
                   class="admin-cancel-btn">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>