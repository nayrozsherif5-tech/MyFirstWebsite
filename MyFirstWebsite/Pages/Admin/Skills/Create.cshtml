@page
@model MyFirstWebsite.Pages.Admin.Skills.CreateModel

@{
    ViewData["Title"] = "Add Skill";
}

<div class="admin-form-page">

    <div class="admin-form-header">
        <h1>➕ Add Skill</h1>
        <p>Add a new technical skill to your portfolio.</p>
    </div>

    <div class="admin-form-card">

        <form method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="admin-form-group">
                <label asp-for="Skill.Name">
                    Skill Name
                </label>

                <input asp-for="Skill.Name"
                       class="admin-form-control"
                       placeholder="Example: Python" />

                <span asp-validation-for="Skill.Name"
                      class="text-danger"></span>
            </div>

            <div class="admin-form-group">
                <label asp-for="Skill.Category">
                    Category
                </label>

                <input asp-for="Skill.Category"
                       class="admin-form-control"
                       placeholder="Example: Programming Languages" />

                <span asp-validation-for="Skill.Category"
                      class="text-danger"></span>
            </div>

           

            <div class="admin-form-actions">

                <button type="submit"
                        class="admin-save-btn">
                    ➕ Add Skill
                </button>

                <a asp-page="Index"
                   class="admin-cancel-btn">
                    Cancel
                </a>

            </div>

        </form>

    </div>

    <hr />

    <form method="post"
          asp-page-handler="AddDefaultSkills">

        <button type="submit"
                class="admin-save-btn">
            ✨ Add My Skills
        </button>

    </form>

</div>