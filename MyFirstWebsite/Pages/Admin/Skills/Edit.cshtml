@page
@model MyFirstWebsite.Pages.Admin.Skills.EditModel

@{
    ViewData["Title"] = "Edit Skill";
}

<div class="admin-form-page">

    <div class="admin-form-header">
        <h1>✏️ Edit Skill</h1>
        <p>Update your technical skill.</p>
    </div>

    <div class="admin-form-card">

        <form method="post">

            <input type="hidden"
                   asp-for="Skill.Id" />

            <div class="admin-form-group">

                <label asp-for="Skill.Name">
                    Skill Name
                </label>

                <input asp-for="Skill.Name"
                       class="admin-form-control" />

            </div>

            <div class="admin-form-group">

                <label asp-for="Skill.Category">
                    Category
                </label>

                <input asp-for="Skill.Category"
                       class="admin-form-control" />

            </div>

            <div class="admin-form-actions">

                <button type="submit"
                        class="admin-save-btn">
                    💾 Save Changes
                </button>

                <a asp-page="Index"
                   class="admin-cancel-btn">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>