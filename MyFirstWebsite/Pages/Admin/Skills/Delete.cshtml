@page
@model MyFirstWebsite.Pages.Admin.Skills.DeleteModel

@{
    ViewData["Title"] = "Delete Skill";
}

<div class="admin-form-page">

    <div class="admin-form-header">
        <h1>🗑 Delete Skill</h1>
        <p>Review the skill before deleting it.</p>
    </div>

    <div class="admin-form-card">

        <div class="delete-warning-box">
            <h3>Are you sure you want to delete this skill?</h3>
            <p>This action cannot be undone.</p>
        </div>

        <div class="current-file">

            <div>
                <span>💻</span>

                <div>
                    <strong>@Model.Skill.Name</strong>
                    <p>@Model.Skill.Category</p>
                </div>
            </div>

        </div>

        <form method="post">

            <input type="hidden" asp-for="Skill.Id" />

            <div class="admin-form-actions">

                <button type="submit"
                        class="admin-delete-btn">
                    🗑 Delete Skill
                </button>

                <a asp-page="Index"
                   class="admin-cancel-btn">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>