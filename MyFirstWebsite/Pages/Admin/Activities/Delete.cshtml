@page "{id:int}"
@model MyFirstWebsite.Pages.Admin.Activities.DeleteModel

@{
    ViewData["Title"] = "Delete Activity";
}

<div class="admin-form-page">

    <a asp-page="Index" class="admin-back-btn">
        ← Back to Activities
    </a>

    <div class="admin-form-header">
        <h1>🗑 Delete Activity</h1>
        <p>Review the activity before deleting it.</p>
    </div>

    <div class="admin-form-card delete-confirmation-card">

        <div class="delete-warning-box">
            <div class="delete-warning-icon">⚠️</div>

            <div>
                <h3>Are you sure you want to delete this activity?</h3>
                <p>This action cannot be undone.</p>
            </div>
        </div>

        <div class="delete-item-preview">

            <div class="delete-item-icon">
                🌟
            </div>

            <div class="delete-item-info">

                <strong>@Model.Activity.Title</strong>

                <p>@Model.Activity.Organization</p>

            </div>

        </div>

        <form method="post">

            <input type="hidden"
                   asp-for="Activity.Id" />

            <div class="admin-form-actions">

                <button type="submit"
                        class="admin-delete-btn">
                    🗑 Delete Activity
                </button>

                <a asp-page="Index"
                   class="admin-cancel-btn">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>