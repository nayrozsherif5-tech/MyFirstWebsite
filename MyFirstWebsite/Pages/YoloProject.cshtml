@page
@model MyFirstWebsite.Pages.YoloProjectModel

@{
    ViewData["Title"] = "YOLO Object Detection & Tracking";
}

<div class="project-detail-page">

    <!-- Heading -->
    <div class="project-detail-heading">

        <span class="section-kicker">PROJECT DETAILS</span>

        <h1>YOLO Object Detection & Tracking</h1>

        <p>
            A real-time computer vision project for detecting and tracking
            multiple objects in video streams using YOLO, OpenCV, and Deep SORT.
        </p>

    </div>


    <!-- Hero Image -->
    <div class="project-detail-hero">

        <img src="/image/YoloPic.png"
             alt="YOLO Object Detection & Tracking"
             class="project-detail-main-image" />

    </div>


    <!-- Technologies -->
    <div class="project-detail-tags">

        <span>Python</span>
        <span>OpenCV</span>
        <span>YOLO</span>
        <span>Deep SORT</span>

    </div>


    <!-- Actions -->
    <div class="project-detail-actions">

        <a href="https://github.com/nayrozsherif5-tech/CodeAlpha_ObjectDetectionTracking"
           target="_blank"
           class="detail-primary-btn">
            View GitHub
        </a>

        <a asp-page="/Projects"
           class="detail-secondary-btn">
            ← Back to Projects
        </a>

    </div>


    <!-- Overview -->
    <section class="project-detail-section">

        <span class="section-kicker">OVERVIEW</span>

        <h2>About the project</h2>

        <p>
            Developed a real-time object detection and tracking system using
            YOLO and OpenCV. The application processes video streams,
            detects objects in individual frames, and tracks them across
            consecutive frames using Deep SORT.
        </p>

    </section>


    <!-- Problem / Solution -->
    <div class="project-detail-grid">

        <div class="project-detail-card">

            <span class="detail-card-label">PROBLEM</span>

            <h3>Maintaining reliable tracking</h3>

            <p>
                Object detection identifies objects in individual frames,
                but maintaining consistent identities across a moving video
                stream requires an additional tracking mechanism.
            </p>

        </div>


        <div class="project-detail-card">

            <span class="detail-card-label">SOLUTION</span>

            <h3>Detection and tracking combined</h3>

            <p>
                YOLO is used for fast object detection while Deep SORT
                maintains object identities across frames, allowing the
                system to perform real-time multi-object tracking.
            </p>

        </div>

    </div>


    <!-- Features -->
    <section class="project-detail-section">

        <span class="section-kicker">KEY FEATURES</span>

        <h2>What the system can do</h2>

        <div class="detail-features-grid">

            <div class="detail-feature-card">

                <h3>Real-Time Detection</h3>

                <p>
                    Processes video streams and detects objects
                    with low latency.
                </p>

            </div>


            <div class="detail-feature-card">

                <h3>Multi-Object Tracking</h3>

                <p>
                    Tracks multiple detected objects consistently
                    across consecutive video frames.
                </p>

            </div>


            <div class="detail-feature-card">

                <h3>Confidence Scores</h3>

                <p>
                    Displays confidence values for each
                    detected object.
                </p>

            </div>


            <div class="detail-feature-card">

                <h3>Visual Detection Output</h3>

                <p>
                    Draws bounding boxes and labels directly
                    on the processed video.
                </p>

            </div>

        </div>

    </section>


    <!-- Gallery -->
    <section class="project-detail-section">

        <span class="section-kicker">GALLERY</span>

        <h2>Project preview</h2>

        <div class="project-detail-gallery">

            <img src="/image/YoloSC1.jpg"
                 alt="YOLO detecting cars and people" />

        </div>

        <p class="gallery-caption">
            Object detection with bounding boxes, labels, and confidence scores.
        </p>

    </section>


    <!-- Bottom CTA -->
    <div class="project-detail-bottom">

        <h2>Explore the project</h2>

        <p>
            View the source code or return to the complete project collection.
        </p>

        <div class="project-detail-actions">

            <a href="https://github.com/nayrozsherif5-tech/CodeAlpha_ObjectDetectionTracking"
               target="_blank"
               class="detail-primary-btn">
                View GitHub
            </a>

            <a asp-page="/Projects"
               class="detail-secondary-btn">
                Back to Projects
            </a>

        </div>

    </div>

</div>