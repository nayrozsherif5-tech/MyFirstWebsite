@page
@model MyFirstWebsite.Pages.UavProjectModel
@{
    ViewData["Title"] = "Swarm UAV Project";
}

<div class="project-detail-page">

    <!-- Heading -->
    <div class="project-detail-heading">

        <span class="section-kicker">PROJECT DETAILS</span>

        <h1>Swarm UAV Project</h1>

        <p>
            An engineering design project focused on developing UAV frame concepts
            using Fusion 360 with attention to aerodynamic efficiency and structural strength.
        </p>

    </div>


    <!-- Hero Image -->
    <div class="project-detail-hero">

        <img src="/image/SwarmUAV.png"
             alt="Swarm UAV Project"
             class="project-detail-main-image" />

    </div>


    <!-- Technologies -->
    <div class="project-detail-tags">

        <span>Fusion 360</span>
        <span>UAV Design</span>
        <span>Aerodynamics</span>
        <span>Structural Design</span>

    </div>


    <!-- Actions -->
    <div class="project-detail-actions">

        <a asp-page="/Projects"
           class="detail-secondary-btn">
            ← Back to Projects
        </a>

    </div>


    <!-- Overview -->
    <section class="project-detail-section">

        <span class="section-kicker">OVERVIEW</span>

        <h2>About the project</h2>

        <p>
            Designed two UAV frame concepts using Fusion 360 as part of a
            Swarm UAV engineering project. The designs explored different
            structural approaches while considering aerodynamic performance,
            stability, and frame durability.
        </p>

    </section>


    <!-- Problem / Solution -->
    <div class="project-detail-grid">

        <div class="project-detail-card">

            <span class="detail-card-label">PROBLEM</span>

            <h3>Balancing performance and strength</h3>

            <p>
                UAV frames need to remain lightweight and aerodynamic while
                still providing enough structural strength to support the
                aircraft components and withstand operational forces.
            </p>

        </div>


        <div class="project-detail-card">

            <span class="detail-card-label">SOLUTION</span>

            <h3>Two design approaches</h3>

            <p>
                Two frame concepts were created in Fusion 360, allowing
                different design approaches to be explored for aerodynamic
                efficiency and structural integrity.
            </p>

        </div>

    </div>


    <!-- Key Areas -->
    <section class="project-detail-section">

        <span class="section-kicker">DESIGN FOCUS</span>

        <h2>Engineering considerations</h2>

        <div class="detail-features-grid">

            <div class="detail-feature-card">

                <h3>Aerodynamic Design</h3>

                <p>
                    Considered frame geometry and layout with the goal
                    of reducing unnecessary aerodynamic resistance.
                </p>

            </div>


            <div class="detail-feature-card">

                <h3>Structural Integrity</h3>

                <p>
                    Designed the frame structure to provide support
                    and stability for UAV components.
                </p>

            </div>


            <div class="detail-feature-card">

                <h3>3D CAD Modeling</h3>

                <p>
                    Created detailed UAV frame models using Fusion 360.
                </p>

            </div>


            <div class="detail-feature-card">

                <h3>Design Comparison</h3>

                <p>
                    Developed two frame concepts to compare different
                    structural and aerodynamic approaches.
                </p>

            </div>

        </div>

    </section>


    <!-- Frame Designs -->
    <section class="project-detail-section">

        <span class="section-kicker">3D DESIGNS</span>

        <h2>UAV frame concepts</h2>

        <div class="uav-detail-grid">


            <!-- Frame 1 -->
            <div class="uav-detail-card">

                <img src="/image/Frame1.jpg"
                     alt="UAV Frame Design 1" />

                <div class="uav-detail-content">

                    <h3>Frame Design 1</h3>

                    <p>
                        UAV frame concept developed with a focus
                        on aerodynamic efficiency.
                    </p>

                    <a href="https://gmail4751442.autodesk360.com/g/shares/SH286ddQT78850c0d8a46962730d491aabf4"
                       target="_blank"
                       class="detail-primary-btn">
                        View 3D Model
                    </a>

                </div>

            </div>


            <!-- Frame 2 -->
            <div class="uav-detail-card">

                <img src="/image/Frame2.jpg"
                     alt="UAV Frame Design 2" />

                <div class="uav-detail-content">

                    <h3>Frame Design 2</h3>

                    <p>
                        UAV frame concept developed with a focus
                        on structural integrity and stability.
                    </p>

                    <a href="https://gmail4751442.autodesk360.com/g/shares/SH286ddQT78850c0d8a4d40713cfd9068a7b"
                       target="_blank"
                       class="detail-primary-btn">
                        View 3D Model
                    </a>

                </div>

            </div>

        </div>

    </section>


    <!-- Bottom -->
    <div class="project-detail-bottom">

        <h2>Explore more projects</h2>

        <p>
            Return to the project collection to see my AI,
            Computer Vision, Web Development, and Engineering work.
        </p>

        <div class="project-detail-actions">

            <a asp-page="/Projects"
               class="detail-secondary-btn">
                Back to Projects
            </a>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const elements = document.querySelectorAll(
                ".detail-card, .feature-card, .gallery-img, .uav-frame"
            );

            const observer = new IntersectionObserver((entries) => {

                entries.forEach(entry => {

                    if (entry.isIntersecting) {
                        entry.target.classList.add("visible");
                    }

                });

            }, {
                threshold: 0.15
            });

            elements.forEach(el => observer.observe(el));

        });
    </script>
}