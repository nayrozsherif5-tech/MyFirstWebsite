@page
@model MyFirstWebsite.Pages.CertificatesModel

@{
    ViewData["Title"] = "Certificates";
}

<div class="certificates-page">

    <!-- Heading -->
    <div class="certificates-heading">

        <span class="section-kicker">
            CERTIFICATIONS
        </span>

        <h1>
            Professional certifications
        </h1>

        <p>
            Certifications, internships, and training programs
            that reflect my technical and professional development.
        </p>

    </div>


    @if (Model.Certificates.Count > 0)
    {
        <div class="certificates-grid">

            @foreach (var certificate in Model.Certificates)
            {
                <div class="certificate-modern-card">

                    <div class="certificate-content">

                        <span class="certificate-label">
                            CERTIFICATE
                        </span>

                        <h3>
                            @certificate.Title
                        </h3>

                        <p class="certificate-issuer">
                            @certificate.Organization
                            <span>•</span>
                            @certificate.Date.Year
                        </p>

                        <p class="certificate-description">
                            @certificate.Description
                        </p>

                    </div>


                    <div class="certificate-action">

                        @if (!string.IsNullOrWhiteSpace(certificate.CertificateLink))
                        {
                            <a href="@certificate.CertificateLink"
                               target="_blank"
                               class="detail-primary-btn">

                                View Credential →

                            </a>
                        }

                        else if (!string.IsNullOrWhiteSpace(certificate.ImagePath))
                        {
                            <a href="@certificate.ImagePath"
                               target="_blank"
                               class="detail-primary-btn">

                                View Credential →

                            </a>
                        }

                    </div>

                </div>
            }

        </div>
    }

</div>