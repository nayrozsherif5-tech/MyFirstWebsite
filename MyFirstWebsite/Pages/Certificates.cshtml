@page
@model MyFirstWebsite.Pages.CertificatesModel
@{
    ViewData["Title"] = "Certificates";
}

<h1>🏆 Professional Certifications</h1>



@if (Model.Certificates.Count > 0)
{
    @foreach (var certificate in Model.Certificates)
    {
        <div class="card">

            <h3>@certificate.Title</h3>

            <p class="issuer">
                Issued by <strong>@certificate.Organization</strong>
                • @certificate.Date.Year
            </p>

            <p>
                @certificate.Description
            </p>

            @if (!string.IsNullOrWhiteSpace(certificate.CertificateLink))
            {
                <a class="btn"
                   href="@certificate.CertificateLink"
                   target="_blank">
                    📄 View Credential
                </a>
            }
            else if (!string.IsNullOrWhiteSpace(certificate.ImagePath))
            {
                <a class="btn"
                   href="@certificate.ImagePath"
                   target="_blank">
                    📄 View Credential
                </a>
            }

        </div>
    }
}