@page
@model MyFirstWebsite.Pages.ReferencesModel

@{
    ViewData["Title"] = "References";
}

<div class="references-page">

    <div class="references-heading">

        <span class="section-kicker">REFERENCES</span>

        <h1>Professional references</h1>

        <p>
            Reference letters and professional feedback from
            internships and training experiences.
        </p>

    </div>


    @if (Model.References.Count == 0)
    {
        <div class="references-empty">
            <p>No references available yet.</p>
        </div>
    }
    else
    {
        <div class="references-grid">

            @foreach (var reference in Model.References)
            {
                <div class="reference-modern-card">

                    <div class="reference-content">

                        <span class="reference-label">
                            REFERENCE
                        </span>

                        <h3>
                            @reference.Title
                        </h3>

                        <p>
                            @reference.Description
                        </p>

                    </div>


                    <div class="reference-action">

                        @if (!string.IsNullOrWhiteSpace(reference.FilePath))
                        {
                            <a href="@reference.FilePath"
                               target="_blank"
                               class="detail-primary-btn">

                                View Reference →

                            </a>
                        }

                        else if (!string.IsNullOrWhiteSpace(reference.ReferenceLink))
                        {
                            <a href="@reference.ReferenceLink"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="detail-primary-btn">

                                View Reference →

                            </a>
                        }

                    </div>

                </div>
            }

        </div>
    }

</div>