@page
@model MyFirstWebsite.Pages.ReferencesModel

@{
    ViewData["Title"] = "References";
}

<h1>📄 References</h1>

@if (Model.References.Count == 0)
{
    <p>No references available yet.</p>
}
else
{
    @foreach (var reference in Model.References)
    {
        <div class="card">

            <h3>@reference.Title</h3>

            <p>@reference.Description</p>

            @if (!string.IsNullOrWhiteSpace(reference.FilePath))
            {
                <a class="btn"
                   href="@reference.FilePath"
                   target="_blank">
                    📄 View Reference
                </a>
            }
            else if (!string.IsNullOrWhiteSpace(reference.ReferenceLink))
            {
                <a class="btn"
                   href="@reference.ReferenceLink"
                   target="_blank"
                   rel="noopener noreferrer">
                    🔗 View Reference
                </a>
            }

        </div>
    }
}