@page
@model MyFirstWebsite.Pages.FaqChatbotModel
@{
    ViewData["Title"] = "AI FAQ Chatbot";
}

<div class="project-detail-page">

    <!-- Top -->
    <div class="project-detail-heading">

        <span class="section-kicker">PROJECT DETAILS</span>

        <h1>AI FAQ Chatbot</h1>

        <p>
            An Artificial Intelligence and NLP project built to match
            user questions with the most relevant FAQ answers.
        </p>

    </div>


    <!-- Hero Image -->
    <div class="project-detail-hero">

        <img src="/image/Chatbot2SC.png"
             alt="AI FAQ Chatbot"
             class="project-detail-main-image" />

    </div>


    <!-- Quick Info -->
    <div class="project-detail-tags">

        <span>Python</span>
        <span>NLP</span>
        <span>Scikit-Learn</span>
        <span>Cosine Similarity</span>

    </div>


    <!-- Buttons -->
    <div class="project-detail-actions">

        <a href="https://github.com/nayrozsherif5-tech/CodeAlpha_ChatbotFAQ"
           target="_blank"
           class="detail-primary-btn">
            View GitHub
        </a>

        <a asp-page="/Projects"
           class="detail-secondary-btn">
            ← Back to Projects
        </a>

    </div>


    <!-- Overview -->
    <section class="project-detail-section">

        <span class="section-kicker">OVERVIEW</span>

        <h2>About the project</h2>

        <p>
            AI-powered FAQ chatbot developed during my Artificial
            Intelligence Internship at CodeAlpha. The chatbot uses
            Natural Language Processing and cosine similarity to
            understand user questions and return the most relevant
            answer from a predefined FAQ dataset.
        </p>

    </section>


    <!-- Problem / Solution -->
    <div class="project-detail-grid">

        <div class="project-detail-card">

            <span class="detail-card-label">PROBLEM</span>

            <h3>Finding answers quickly</h3>

            <p>
                Users need an efficient way to retrieve answers from
                FAQ datasets without manually searching through
                large amounts of information.
            </p>

        </div>


        <div class="project-detail-card">

            <span class="detail-card-label">SOLUTION</span>

            <h3>Intelligent FAQ matching</h3>

            <p>
                The chatbot processes user input and compares it
                with stored FAQ questions using cosine similarity,
                returning the most relevant answer.
            </p>

        </div>

    </div>


    <!-- Features -->
    <section class="project-detail-section">

        <span class="section-kicker">KEY FEATURES</span>

        <h2>What the chatbot can do</h2>

        <div class="detail-features-grid">

            <div class="detail-feature-card">

                <h3>NLP Processing</h3>

                <p>
                    Processes natural language queries using
                    text preprocessing and vectorization.
                </p>

            </div>


            <div class="detail-feature-card">

                <h3>FAQ Matching</h3>

                <p>
                    Matches user questions against a structured
                    FAQ dataset.
                </p>

            </div>


            <div class="detail-feature-card">

                <h3>Cosine Similarity</h3>

                <p>
                    Measures similarity between user input and
                    stored FAQ questions.
                </p>

            </div>


            <div class="detail-feature-card">

                <h3>Real-Time Responses</h3>

                <p>
                    Returns the most relevant response immediately
                    based on the similarity score.
                </p>

            </div>

        </div>

    </section>


    <!-- Gallery -->
    <section class="project-detail-section">

        <span class="section-kicker">GALLERY</span>

        <h2>Project preview</h2>

        <div class="project-detail-gallery">

            <img src="/image/ChatbotSC.jpg"
                 alt="FAQ Chatbot Screenshot" />

        </div>

        <p class="gallery-caption">
            Chatbot interface answering Artificial Intelligence questions.
        </p>

    </section>


    <!-- Bottom CTA -->
    <div class="project-detail-bottom">

        <h2>Explore the project</h2>

        <p>
            View the source code or return to the full project collection.
        </p>

        <div class="project-detail-actions">

            <a href="https://github.com/nayrozsherif5-tech/CodeAlpha_ChatbotFAQ"
               target="_blank"
               class="detail-primary-btn">
                View GitHub
            </a>

            <a asp-page="/Projects"
               class="detail-secondary-btn">
                Back to Projects
            </a>

        </div>

    </div>

</div>