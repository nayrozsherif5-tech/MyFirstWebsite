@page
@model MyFirstWebsite.Pages.FaqChatbotModel
@{
    ViewData["Title"] = "AI FAQ Chatbot";
}

<div class="project-details-container">

    <!-- Hero Section -->
    <img src="/image/Chatbot2SC.png"
         class="project-hero-image"
         alt="AI FAQ Chatbot" />

    <div class="hero-content">
        <h1>🤖 AI FAQ Chatbot</h1>
        <p class="project-subtitle">Artificial Intelligence & NLP Project</p>

        <div class="project-tags">
            <span class="tech">Python</span>
            <span class="tech">NLP</span>
            <span class="tech">Scikit-Learn</span>
            <span class="tech">Cosine Similarity</span>
        </div>

        <div class="hero-buttons">
            <a class="btn" href="https://your-demo-link" target="_blank">Try Demo</a>
            <a class="btn" href="https://github.com/nayrozsherif5-tech/CodeAlpha_ChatbotFAQ" target="_blank">View Code</a>
            <a asp-page="/Projects" class="btn">Back to Projects</a>
        </div>
    </div>
</div>

<!-- Overview -->
<div class="detail-card">
    <h2>📋 Overview</h2>
    <p>
        AI-powered FAQ chatbot developed during my Artificial Intelligence Internship at CodeAlpha.
        The chatbot uses Natural Language Processing and Cosine Similarity to understand user questions
        and return the most relevant answer from a predefined FAQ dataset.
    </p>
</div>

<!-- Problem & Solution -->
<div class="info-grid">
    <div class="detail-card">
        <h2>🎯 Problem</h2>
        <p>
            Users needed a way to quickly retrieve answers from FAQ datasets without manually searching documents.
        </p>
    </div>

    <div class="detail-card">
        <h2>💡 Solution</h2>
        <p>
            Developed an NLP chatbot using cosine similarity to return the most relevant answer.
        </p>
    </div>
</div>

<!-- Key Features -->
<h2 class="section-title">✨ Key Features</h2>
<div class="features-grid">
    <div class="feature-card">🧠 NLP Processing <p>Processes natural language queries with tokenization and vectorization.</p></div>
    <div class="feature-card">📄 FAQ Matching <p>Matches user queries against a structured FAQ dataset.</p></div>
    <div class="feature-card">🎯 Cosine Similarity <p>Measures similarity between user input and stored questions.</p></div>
    <div class="feature-card">💬 Intelligent Responses <p>Provides clear, concise answers in real time.</p></div>
</div>

<!-- Gallery -->
<div class="detail-card">
    <h2>🖼 Project Gallery</h2>
    <div class="gallery">
        <img src="/image/ChatbotSC.jpg" class="gallery-img" alt="FAQ Chatbot Screenshot" />
        <figcaption>Chatbot answering AI questions</figcaption>
       
    </div>
</div>

<!-- Footer Buttons -->
<div class="project-buttons">
    <a class="btn" href="https://github.com/nayrozsherif5-tech/CodeAlpha_ChatbotFAQ" target="_blank">View Code</a>
    <a asp-page="/Projects" class="btn">Back to Projects</a>
</div>

<!-- Footer -->
<div class="footer-contact">
    <div class="footer-links">
        <a href="https://github.com/nayrozsherif5-tech" target="_blank">GitHub</a>
        <a href="https://linkedin.com/in/nayroz" target="_blank">LinkedIn</a>
        <a href="mailto:nayroz@example.com">Email</a>
    </div>
    <div class="footer">Built with ❤️ by Nayroz</div>
</div>

<!-- Fade-in animation script -->
@section Scripts {
    <script>
        document.addEventListener("scroll", function() {
            document.querySelectorAll(".detail-card, .feature-card, .gallery-img").forEach(el => {
                const rect = el.getBoundingClientRect();
                if (rect.top < window.innerHeight - 100) {
                    el.classList.add("visible");
                }
            });
        });
    </script>
}

